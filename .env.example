# ============================================================
# ロケハン3D オンライン — environment variables (template)
# Copy to .env.local and fill in. Do NOT commit .env.local.
# ============================================================

# --- Clerk (Authentication) --------------------------------
# Get from https://dashboard.clerk.com — create a "Locahun3D Online" application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Stripe (Subscriptions + future Connect marketplace) ---
# Get from https://dashboard.stripe.com — start in test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for plans defined in /pricing (create them in Stripe first).
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# --- Cloudflare R2 (3DGS + image storage) ------------------
# Existing bucket: locahun3d-assets
# Account ID from project_locahun3d_online_handoff memory.
R2_ACCOUNT_ID=9ad06a76157fb2f40dfef1f4b7a14a93
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=locahun3d-assets
R2_PUBLIC_URL=https://pub-6fe11fc6301a424ba739695a7c4d2dd9.r2.dev

# --- Cloudflare D1 (DB) ------------------------------------
# Bound at deploy via wrangler.toml. For local dev with miniflare,
# wrangler creates a SQLite file under .wrangler/state automatically.
D1_DATABASE_NAME=locahun3d_online
