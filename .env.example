# ============================================================
# ロケハン3D オンライン — environment variables (template)
# Copy to .env.local and fill in. Do NOT commit .env.local.
# ============================================================

# --- Clerk (Authentication) --------------------------------
# Get from https://dashboard.clerk.com — create a "Locahun3D Online" application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Stripe (Subscriptions + future Connect marketplace) ---
# Get from https://dashboard.stripe.com — start in test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for plans defined in /pricing (create them in Stripe first).
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# --- Uploads ------------------------------------------------
# UPLOAD_MODE=local  -> writes to public/uploads/{propertyId}/ (dev/MVP default)
# UPLOAD_MODE=r2     -> generates presigned PUT URLs against R2 (requires R2_* below)
UPLOAD_MODE=local

# --- Cloudflare R2 (used when UPLOAD_MODE=r2) ---------------
# Existing bucket: locahun3d-assets
# Account ID from project_locahun3d_online_handoff memory.
R2_ACCOUNT_ID=9ad06a76157fb2f40dfef1f4b7a14a93
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=locahun3d-assets
R2_PUBLIC_URL=https://pub-6fe11fc6301a424ba739695a7c4d2dd9.r2.dev

# --- Cloudflare D1 (DB) ------------------------------------
# Bound at deploy via wrangler.toml. For local dev with miniflare,
# wrangler creates a SQLite file under .wrangler/state automatically.
D1_DATABASE_NAME=locahun3d_online

# --- Stripe (Subscriptions) -------------------------------
# キー未設定の間はプラン変更は即時反映スタブで動作（課金は走らない）。
# テストキー(sk_test_…/pk_test_…)を入れるとテストモードで本番フローを確認可能。
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` が表示する whsec_…
STRIPE_WEBHOOK_SECRET=
# Checkout の戻り先（本番は https://locahun3d.com を設定）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 各プランの Price ID（Stripeダッシュボードで月額/年額の商品を作成）
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# 地図タイル（Mapbox、無料枠は月5万マップロードまで商用利用可）。
# https://account.mapbox.com/access-tokens/ で作成した公開トークン(pk.…)を設定。
# 未設定時は OpenStreetMap 標準タイルにフォールバック（開発用・本番の継続
# トラフィックには使えない — 本番は必ず設定すること）。
NEXT_PUBLIC_MAPBOX_TOKEN=
