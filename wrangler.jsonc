{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locahun3d-online",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "locahun3d-assets"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://locahun3d.com",
    "R2_BUCKET": "locahun3d-assets",
    "R2_PUBLIC_URL": "https://pub-6fe11fc6301a424ba739695a7c4d2dd9.r2.dev",
    "UPLOAD_MODE": "r2",
    "STRIPE_PRICE_INDIVIDUAL_MONTHLY": "price_1Tlb2LRyHEgXelRysKE4Giy7",
    "STRIPE_PRICE_INDIVIDUAL_ANNUAL": "price_1Tlb2MRyHEgXelRy6CEiIoya",
    "STRIPE_PRICE_STUDIO_MONTHLY": "price_1Tlb2NRyHEgXelRyEOHhpPxa",
    "STRIPE_PRICE_STUDIO_ANNUAL": "price_1Tlb2NRyHEgXelRyZqwghKCL",
    "STRIPE_PRICE_TEAM_MONTHLY": "price_1Tlb2ORyHEgXelRywSLcbT7s",
    "STRIPE_PRICE_TEAM_ANNUAL": "price_1Tlb2ORyHEgXelRyZnqqhqEP"
  },
  "routes": [
    { "pattern": "locahun3d.com", "custom_domain": true },
    { "pattern": "www.locahun3d.com", "custom_domain": true }
  ]
}
