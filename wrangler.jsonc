{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locahun3d-online",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Workers 監視: 実行ログ/例外/呼び出し数を Cloudflare 側に蓄積し、ダッシュボードの
  // Observability から検索・可視化できる（wrangler tail の手動監視に依存しない）。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "locahun3d-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "locahun3d-db",
      "database_id": "d296a328-97ae-4700-a4f9-a5003b6c4f67"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://locahun3d.com",
    "R2_BUCKET": "locahun3d-assets",
    "R2_PUBLIC_URL": "https://pub-6fe11fc6301a424ba739695a7c4d2dd9.r2.dev",
    "UPLOAD_MODE": "r2",
    "STRIPE_PRICE_INDIVIDUAL_MONTHLY": "price_1ToV9w3G4r5QaMCIJJmi6WQU",
    "STRIPE_PRICE_INDIVIDUAL_ANNUAL": "price_1ToVA33G4r5QaMCI441wSpf9",
    "STRIPE_PRICE_STUDIO_MONTHLY": "price_1ToVAV3G4r5QaMCIQ6C4CjrS",
    "STRIPE_PRICE_STUDIO_ANNUAL": "price_1ToVAX3G4r5QaMCIQuL3gvIS",
    "STRIPE_PRICE_TEAM_MONTHLY": "price_1ToVB43G4r5QaMCIO3xLjUCb",
    "STRIPE_PRICE_TEAM_ANNUAL": "price_1ToVB73G4r5QaMCIlQMEmIPG"
  },
  "routes": [
    { "pattern": "locahun3d.com", "custom_domain": true },
    { "pattern": "www.locahun3d.com", "custom_domain": true }
  ]
}
