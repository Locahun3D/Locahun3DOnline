# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# wrangler / cloudflare local state
.wrangler/
.dev.vars

# Local-mode uploads (UPLOAD_MODE=local). Real assets live on R2, not in git.
/public/uploads/
!/public/uploads/.gitkeep

# Local-auth user store — contains password hashes. Each env seeds its own
# admin from ADMIN_EMAIL / ADMIN_PASSWORD. Never commit. (Migrates to D1/Clerk.)
/data/users.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# Playwright QA screenshots
/shots/

# View analytics store (local)
/data/analytics.json

# Gift code store (local) — redemption records tied to users. Migrates to D1.
/data/gift-codes.json

# Site settings (local) — 限定無料期間 などの運用設定。Migrates to D1.
/data/site-settings.json

# Inquiry / notification / general-contact stores (local dev fallback). Migrate to D1.
/data/inquiries.json
/data/notifications.json
/data/contact-requests.json

# Build / deploy logs
build-*.log
deploy-*.log
dev-server*.log
tail*.log

# Temp files
temp-*.png
temp-*.mp4
cors.json

# OpenNext build output
/.open-next/

# Viewer backup copies
public/viewer/*.bak
